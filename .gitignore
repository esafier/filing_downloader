# Legacy API Ninjas key file (no longer read by the tool; kept private)
.env

# Python cache files
__pycache__/
*.pyc

# IDE and tool files
.vscode/
# Local Claude Code working files, except skills/commands —
# those are tracked so they load in cloud/web sessions.
.claude/*
!.claude/skills/
!.claude/commands/

# Task tracking (internal)
tasks/

# PyInstaller build output (rebuild with: python -m PyInstaller downloader.spec)
build/
dist/

# Downloaded EDGAR index files (data, not code)
*.idx

# Weekly refresh console output (Run_Weekly_Refresh.bat)
refresh_console.log
